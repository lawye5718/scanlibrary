# ============================================================
# ScanLibrary 版本管理忽略规则
# 只把「代码 + 文档」纳入 git；运行时数据与书籍产物一律不进仓库。
# ============================================================

# ---- 运行时数据（含登录密码，务必忽略）----
data/

# ---- 上传的 PDF 原件（体积大、可能受版权保护）----
uploads/

# ---- 转换产物：EPUB / Markdown / 逐页渲染图 / OCR 缓存 ----
books/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# ---- 打包与安装产物 ----
build/
dist/
*.egg-info/

# ---- 系统与编辑器 ----
.DS_Store
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
*~

# ---- 日志与临时文件 ----
*.log
*.tmp
*.bak
